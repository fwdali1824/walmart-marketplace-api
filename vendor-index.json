      }
    },
    {
      "name": "ABC Computers Inc",
      "sellerId": "abc-computers-001",
      "specFile": "abc-spec.json",
      "description": "Computer and IT equipment seller",
      "endpoints": {
        "spec": "/api/walmart-spec/abc",
        "orders": "/api/v3/abc/orders",
        "products": "/api/v3/abc/items",
        "health": "/api/health/abc"
      }
    }
  ],
  "masterSpec": {
    "file": "walmart-spec.json",

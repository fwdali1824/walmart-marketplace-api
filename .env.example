# Walmart Marketplace API - Environment Configuration Example

# Environment
WALMART_ENV=local

# Base URL
WALMART_BASE_URL=http://localhost:3000

# Authentication
WALMART_CLIENT_ID=wm_your_client_id_here
WALMART_CLIENT_SECRET=your_client_secret_here
WALMART_PARTNER_ID=your_partner_id

# Seller/Vendor Information (for multi-vendor setup)
WALMART_SELLER_ID=your_seller_id
VENDOR_NAME=Your Vendor Name
VENDOR_COUNTRY=US

# Application URLs
WALMART_APPLICATION_URL=http://localhost:5173/connections/walmart
WALMART_REDIRECT_URI=http://localhost:5173/connections/register-walmart

# API Endpoints
WALMART_AUTHORIZE_URL=http://localhost:3000/v3/authorize
WALMART_SPEC_URL=http://localhost:3000/api/walmart-spec

# Features
WALMART_INCLUDE_TEST_ORDERS=false
WALMART_FORCE_SDK=false

# Token Management
TOKEN_CACHE_TTL=900
TOKEN_REFRESH_BEFORE_EXPIRY=120

# Caching
CACHE_DRIVER=database

# Usage:
# For local development: use .env.local
# For Acme vendor: use .env.acme
# For ABC vendor: use .env.abc
# For production: use .env.production
